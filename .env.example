# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/copybot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=copybot
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
REDIS_DEDUP_TTL_SECONDS=300
REDIS_LOCK_TIMEOUT_SECONDS=10.0
REDIS_SESSION_CACHE_TTL_SECONDS=1800

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=evolution_secret_key_123
EVOLUTION_INSTANCE_NAME=copybot

